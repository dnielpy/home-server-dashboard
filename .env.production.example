# APIs of the other apps, through the ports they publish on the host (the API and the web app both use them)
BLUETTI_API_URL=http://host.docker.internal:3001
HOMENET_API_URL=http://host.docker.internal:3011
LOCALTUBE_API_URL=http://host.docker.internal:3005
# Same value as SERVICE_TOKEN in LocalTube's .env.production (openssl rand -hex 32)
LOCALTUBE_SERVICE_TOKEN=change-me
# The agent that updates the projects, running on the host (scripts/install-agent.sh)
AGENT_URL=http://host.docker.internal:3022
UPSTREAM_TIMEOUT_SECONDS=8

TZ=America/Havana

WEB_PORT=3020
API_PORT=3021
