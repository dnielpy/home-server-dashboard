# APIs of the other apps, through the ports they publish on the host (the API and the web app both use them)
BLUETTI_API_URL=http://host.docker.internal:3001
HOMENET_API_URL=http://host.docker.internal:3011
LOCALTUBE_API_URL=http://host.docker.internal:3005
# Same value as SERVICE_TOKEN in LocalTube's .env.production (openssl rand -hex 32)
LOCALTUBE_SERVICE_TOKEN=change-me
# The agent that updates the projects, running on the host (scripts/install-agent.sh)
AGENT_URL=http://host.docker.internal:3022
ASTRO_API_URL=http://host.docker.internal:3024
VIDEO_DOWNLOADER_URL=http://host.docker.internal:3007
# Generated by scripts/install-astro.sh; shared only by the dashboard API and host bridge
# ASTRO_API_TOKEN=
OPENCLAW_STATE_DIR=/mnt/localtube/openclaw/state
UPSTREAM_TIMEOUT_SECONDS=8
# Sender keeps the uploaded packages here until they are downloaded: a folder on the external disk, owned by the
# API container's user (sudo mkdir -p <folder> && sudo chown 10001 <folder>)
SENDER_HOST_DIR=/media/change-me/sender
# The Downloader keeps the files it downloads here, on the external disk too and with the same owner
DOWNLOADS_HOST_DIR=/media/change-me/downloads
DOWNLOADS_PARALLEL=2

# Optional dedicated bot, independent from Astro/OpenClaw. Keep the token private.
# Get the token from @BotFather. OWNER_USER_ID optionally seeds the initial user once.
# Register and remove users in Telegram > Usuarios; the saved list controls access.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
# Telegram state lives in the telegram-state Docker volume (not in the container).

TZ=America/Havana

WEB_PORT=3020
API_PORT=3021
