# Where the APIs of the other apps on the server listen
BLUETTI_API_URL=http://localhost:3001
HOMENET_API_URL=http://localhost:3011
# LocalTube's API (port 8000 in dev, 3005 in production) and the SERVICE_TOKEN set in LocalTube
LOCALTUBE_API_URL=http://localhost:8000
LOCALTUBE_SERVICE_TOKEN=

# The agent that updates the projects (apps/agent), running on the same machine
AGENT_URL=http://localhost:3022

UPSTREAM_TIMEOUT_SECONDS=8

# Where Sender keeps the uploaded packages until they are downloaded
SENDER_DIR=./data/sender

# Where the Downloader keeps the files it downloads, and how many it downloads at once
DOWNLOADS_DIR=./data/downloads
DOWNLOADS_PARALLEL=2

# Dedicated Telegram bot (optional). Add permitted users in Telegram > Usuarios with /add.
# Get the token from @BotFather. OWNER_USER_ID optionally seeds the initial user once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_STATE_DIR=./data/telegram
