# Where the APIs of the other apps on the server listen
BLUETTI_API_URL=http://localhost:3001
HOMENET_API_URL=http://localhost:3011
# LocalTube's API (port 8000 in dev, 3005 in production) and the SERVICE_TOKEN set in LocalTube
LOCALTUBE_API_URL=http://localhost:8000
LOCALTUBE_SERVICE_TOKEN=

# The agent that updates the projects (apps/agent), running on the same machine
AGENT_URL=http://localhost:3022

UPSTREAM_TIMEOUT_SECONDS=8
